rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Helper function to check if user has active admin account
    function isAdmin() {
      return request.auth != null && 
        firestore.exists(/databases/(default)/documents/admins/$(request.auth.uid)) && 
        firestore.get(/databases/(default)/documents/admins/$(request.auth.uid)).data.active == true;
    }
    
    // Helper function to check role access
    function hasRole(roles) {
      return isAdmin() && firestore.get(/databases/(default)/documents/admins/$(request.auth.uid)).data.role in roles;
    }

    // Category cover images path
    match /categories/{categoryId}/cover/{allPaths=**} {
      allow read: if true; // Public view
      allow write: if hasRole(['super_admin', 'catalogue_manager']);
    }

    // Series images path
    match /series/{seriesId}/{allPaths=**} {
      allow read: if true; // Public view
      allow write: if hasRole(['super_admin', 'catalogue_manager']);
    }

    // Product images path
    match /products/{productId}/{allPaths=**} {
      allow read: if true; // Public view
      allow write: if hasRole(['super_admin', 'catalogue_manager']);
    }

    // Brochures PDFs path
    match /brochures/{categoryId}/{allPaths=**} {
      allow read: if true; // Public view
      allow write: if hasRole(['super_admin', 'catalogue_manager']);
    }
  }
}
