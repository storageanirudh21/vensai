rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Default rule: Allow public read access to all files
    // Allow write/upload/delete access to any logged-in user
    allow read: if true;
    allow write: if request.auth != null;

    // Categories cover & category files
    match /categories/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Series images & assets
    match /series/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Product images & assets
    match /products/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Brochures PDFs & files
    match /brochures/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}

